# Runtime Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=3000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/ebazar

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Transactional Email (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=E-Bazar <noreply@e-bazar.com>

# AI & Third-Party Services
AI_API_KEY=your_openai_or_anthropic_api_key_here
VISION_API_KEY=your_vision_api_key_here

# Cloudinary Integration (for image storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Hidden Admin Panel URL Prefix (Must start with a slash, e.g. /xk9m-admin)
ADMIN_PATH=/eb-admin-dashboard
