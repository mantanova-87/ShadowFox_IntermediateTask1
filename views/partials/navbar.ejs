<!-- ===== TOP NAVIGATION BAR ===== -->
<header class="fixed top-0 left-0 right-0 z-50 h-16 glass-panel">
  <div class="max-w-screen-xl mx-auto h-full px-4 flex items-center justify-between gap-4">

    <!-- LEFT: Logo + Brand -->
    <a href="/" class="flex items-center gap-2 shrink-0 group" aria-label="E-Bazar Home">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-navy-DEFAULT flex items-center justify-center shadow-md group-hover:shadow-blue-400/40 transition-shadow duration-200">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <span class="text-lg font-bold text-navy-DEFAULT dark:text-white tracking-tight">E-Bazar</span>
    </a>

    <!-- CENTER: Search Bar (hidden on mobile, expanded via icon) -->
    <form action="/products" method="GET" class="hidden md:flex flex-1 max-w-xl relative" role="search">
      <div class="relative w-full flex items-center">
        <input
          id="search-input"
          type="text"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Search for products, brands, categories..."
          class="glass-input w-full rounded-full pl-5 pr-24 py-2.5 text-sm focus:ring-2 focus:ring-primary transition-all duration-150"
          aria-label="Search products"
          autocomplete="off"
        />
        <!-- Voice Search Button -->
        <button type="button" id="voice-search-btn"
          class="absolute right-10 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-primary transition-colors duration-150"
          aria-label="Voice search"
          title="Voice Search">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
        </button>
        <!-- Image Search Button -->
        <button type="button" id="image-search-btn"
          class="absolute right-2 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-primary transition-colors duration-150"
          aria-label="Image search"
          title="Image Search">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </form>

    <!-- RIGHT ZONE -->
    <div class="flex items-center gap-1 sm:gap-2 shrink-0">

      <% if (typeof user !== 'undefined' && user) { %>
        <!-- Seller Portal pill (if approved seller) -->
        <% if (user.role === 'seller' && user.sellerStatus === 'approved') { %>
          <a href="/seller/dashboard" class="hidden lg:inline-flex items-center gap-1.5 bg-navy-DEFAULT/10 dark:bg-white/10 text-navy-DEFAULT dark:text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-navy-DEFAULT/20 dark:hover:bg-white/20 transition-colors duration-150">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            Seller Portal
          </a>
        <% } %>

        <!-- Wishlist -->
        <a href="/wishlist" class="relative p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150" aria-label="Wishlist">
          <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>

        <!-- Cart -->
        <a href="/cart" class="relative p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150" aria-label="Shopping cart">
          <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span class="absolute -top-0.5 -right-0.5 bg-primary text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none" aria-label="<%= cartCount %> items in cart">
              <%= cartCount > 9 ? '9+' : cartCount %>
            </span>
          <% } %>
        </a>

        <!-- Notifications Bell -->
        <div class="relative" id="notification-dropdown-wrapper">
          <button type="button" id="notification-btn"
            class="relative p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150"
            aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
            <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %>
              <span class="absolute -top-0.5 -right-0.5 bg-rose-DEFAULT text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none">
                <%= unreadNotifs > 9 ? '9+' : unreadNotifs %>
              </span>
            <% } %>
          </button>
        </div>

        <!-- Account Avatar Dropdown -->
        <div class="relative" id="account-dropdown-wrapper">
          <button type="button" id="account-btn"
            class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150"
            aria-label="Account menu" aria-haspopup="true" aria-expanded="false">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.name %> avatar" class="w-7 h-7 rounded-full object-cover ring-2 ring-primary/40" />
            <% } else { %>
              <div class="w-7 h-7 rounded-full bg-gradient-to-br from-primary to-purple-DEFAULT flex items-center justify-center text-white text-xs font-bold">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <svg class="w-3 h-3 text-neutral-400 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <!-- Dropdown Menu -->
          <div id="account-menu" class="hidden absolute right-0 top-full mt-2 w-52 glass-card rounded-2xl shadow-xl border border-neutral-200 dark:border-neutral-700 py-1.5 z-50">
            <div class="px-4 py-2.5 border-b border-neutral-200 dark:border-neutral-700">
              <p class="text-sm font-semibold text-neutral-900 dark:text-white truncate"><%= user.name %></p>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate"><%= user.email %></p>
            </div>
            <a href="/account" class="flex items-center gap-2.5 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700/60 transition-colors duration-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              My Account
            </a>
            <a href="/orders" class="flex items-center gap-2.5 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700/60 transition-colors duration-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              My Orders
            </a>
            <a href="/wishlist" class="flex items-center gap-2.5 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700/60 transition-colors duration-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              Wishlist
            </a>
            <div class="border-t border-neutral-200 dark:border-neutral-700 mt-1 pt-1">
              <form action="/auth/logout" method="POST">
                <button type="submit" class="flex items-center gap-2.5 w-full px-4 py-2 text-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors duration-100">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                  Sign Out
                </button>
              </form>
            </div>
          </div>
        </div>

      <% } else { %>
        <!-- Guest State -->
        <a href="/auth/login" class="text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:text-primary dark:hover:text-blue-400 transition-colors px-3 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">
          Log In
        </a>
        <a href="/auth/register" class="text-sm font-semibold bg-primary text-white px-4 py-2 rounded-full hover:bg-blue-700 active:scale-95 transition-all duration-150 shadow-sm shadow-blue-500/30">
          Sign Up
        </a>
      <% } %>

      <!-- Dark Mode Toggle -->
      <button type="button" id="dark-mode-toggle"
        class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150 ml-1"
        aria-label="Toggle dark mode">
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="icon-sun" class="w-5 h-5 text-amber-400 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="icon-moon" class="w-5 h-5 text-neutral-600 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Mobile Hamburger -->
      <button type="button" id="mobile-menu-btn"
        class="md:hidden p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-150"
        aria-label="Open navigation menu" aria-expanded="false">
        <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Search + Nav Menu (hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-4 py-3 space-y-3">
    <!-- Mobile Search -->
    <form action="/products" method="GET" role="search">
      <input type="text" name="q" placeholder="Search products..."
        class="glass-input w-full rounded-full px-4 py-2.5 text-sm"
        aria-label="Mobile search" />
    </form>
    <!-- Mobile Nav Links -->
    <nav class="flex flex-col gap-0.5">
      <a href="/" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Home</a>
      <a href="/products" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Products</a>
      <a href="/cart" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Cart</a>
      <a href="/wishlist" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Wishlist</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/orders" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Orders</a>
        <a href="/account" class="px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">Account</a>
      <% } else { %>
        <a href="/auth/login" class="px-3 py-2.5 rounded-xl text-sm font-semibold text-primary hover:bg-blue-50 dark:hover:bg-blue-900/20">Log In</a>
        <a href="/auth/register" class="px-3 py-2.5 rounded-xl text-sm font-semibold bg-primary text-white text-center mt-1">Sign Up Free</a>
      <% } %>
    </nav>
  </div>
</header>

<!-- Spacer to push content below fixed navbar -->
<div class="h-16"></div>
