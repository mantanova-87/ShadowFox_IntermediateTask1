<!-- ===== AI CHATBOT FLOATING WIDGET ===== -->
<div id="chatbot-wrapper" aria-live="polite" aria-label="AI Assistant">

  <!-- FAB Trigger Button -->
  <button
    type="button"
    id="chatbot-fab"
    class="fixed bottom-6 right-6 z-[900] w-14 h-14 rounded-full bg-gradient-to-br from-purple-DEFAULT to-indigo-600 text-white shadow-lg shadow-purple-500/40 flex items-center justify-center hover:scale-110 active:scale-95 transition-transform duration-200"
    aria-label="Open AI chat assistant"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="chatbot-panel">
    <!-- Chat Icon -->
    <svg id="chatbot-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
    <!-- Close Icon (shown when open) -->
    <svg id="chatbot-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Chat Panel (side drawer) -->
  <div
    id="chatbot-panel"
    role="dialog"
    aria-modal="true"
    aria-label="MarketBot AI Assistant"
    class="fixed bottom-24 right-6 z-[899] w-80 sm:w-96 max-h-[75vh] glass-card rounded-2xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 origin-bottom-right scale-0 opacity-0 pointer-events-none">

    <!-- Panel Header -->
    <div class="flex items-center gap-3 px-4 py-3 bg-gradient-to-r from-purple-DEFAULT to-indigo-600 text-white shrink-0">
      <div class="relative">
        <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center text-lg">🤖</div>
        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-teal-DEFAULT rounded-full border-2 border-indigo-600"></span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold leading-tight">MarketBot</p>
        <p class="text-xs text-white/70 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-DEFAULT inline-block"></span>
          Online &bull; AI Assistant
        </p>
      </div>
      <button type="button" id="chatbot-minimize" class="p-1 hover:bg-white/20 rounded-lg transition-colors" aria-label="Minimize chat">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
        </svg>
      </button>
    </div>

    <!-- Messages Area -->
    <div id="chatbot-messages" class="flex-1 overflow-y-auto p-4 space-y-3 min-h-0 bg-white/60 dark:bg-neutral-800/60">
      <!-- Welcome message -->
      <div class="flex items-start gap-2">
        <div class="w-7 h-7 rounded-full bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center text-sm shrink-0">🤖</div>
        <div class="bg-neutral-100 dark:bg-neutral-700/80 text-neutral-800 dark:text-neutral-100 text-sm px-3 py-2 rounded-2xl rounded-tl-sm max-w-[80%] leading-relaxed">
          Hi! I'm MarketBot 👋 I can help you find products, track your order, or answer any questions. What can I do for you?
        </div>
      </div>
    </div>

    <!-- Quick Replies -->
    <div class="px-3 pt-2 flex flex-wrap gap-1.5 bg-white/60 dark:bg-neutral-800/60 shrink-0">
      <button type="button" class="chatbot-quick-reply text-xs bg-neutral-100 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 px-3 py-1.5 rounded-full hover:bg-purple-100 dark:hover:bg-purple-900/40 hover:text-purple-700 dark:hover:text-purple-300 transition-colors duration-150">
        Track my order
      </button>
      <button type="button" class="chatbot-quick-reply text-xs bg-neutral-100 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 px-3 py-1.5 rounded-full hover:bg-purple-100 dark:hover:bg-purple-900/40 hover:text-purple-700 dark:hover:text-purple-300 transition-colors duration-150">
        Return an item
      </button>
      <button type="button" class="chatbot-quick-reply text-xs bg-neutral-100 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 px-3 py-1.5 rounded-full hover:bg-purple-100 dark:hover:bg-purple-900/40 hover:text-purple-700 dark:hover:text-purple-300 transition-colors duration-150">
        Find a product
      </button>
    </div>

    <!-- Input Area -->
    <div class="flex items-end gap-2 px-3 pb-3 pt-2 bg-white/60 dark:bg-neutral-800/60 border-t border-neutral-200/60 dark:border-neutral-700/60 shrink-0">
      <textarea
        id="chatbot-input"
        rows="1"
        maxlength="500"
        placeholder="Type your message..."
        class="glass-input flex-1 rounded-xl px-3 py-2 text-sm resize-none max-h-24 leading-relaxed focus:ring-2 focus:ring-purple-400"
        aria-label="Chat message input"
        style="scrollbar-width: thin;"></textarea>
      <button
        type="button"
        id="chatbot-send"
        class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-DEFAULT to-indigo-600 text-white flex items-center justify-center hover:opacity-90 active:scale-95 transition-all duration-150 shrink-0"
        aria-label="Send message">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </div>
  </div>
</div>
