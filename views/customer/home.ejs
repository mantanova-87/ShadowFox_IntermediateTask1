<!-- ===== STOREFRONT HOME PAGE ===== -->

<!-- HERO SECTION -->
<section class="relative overflow-hidden bg-gradient-to-br from-navy-dark via-navy-DEFAULT to-blue-800 text-white">
  <!-- Background decorative blobs -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-16 -left-16 w-72 h-72 bg-purple-DEFAULT/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-screen-xl mx-auto px-4 py-20 sm:py-28 flex flex-col lg:flex-row items-center gap-12">
    <!-- Hero Text -->
    <div class="flex-1 text-center lg:text-left space-y-6">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur px-4 py-1.5 rounded-full text-sm font-medium text-blue-200 border border-white/20">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
        AI-Powered Marketplace
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight">
        Shop Smarter.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-teal-300">Sell Faster.</span>
      </h1>
      <p class="text-lg text-blue-100/80 max-w-lg mx-auto lg:mx-0 leading-relaxed">
        Discover millions of products across all categories. Powered by AI search, voice & image recognition — the future of e-commerce is here.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
        <a href="/products" id="hero-browse-btn"
          class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-blue-500 text-white font-semibold px-8 py-3.5 rounded-full shadow-lg shadow-blue-500/40 hover:shadow-blue-500/60 transition-all duration-200 hover:-translate-y-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Browse Products
        </a>
        <% if (typeof user === 'undefined' || !user) { %>
          <a href="/auth/register" id="hero-signup-btn"
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-8 py-3.5 rounded-full backdrop-blur transition-all duration-200 hover:-translate-y-0.5">
            Sign Up Free
          </a>
        <% } %>
      </div>
    </div>

    <!-- Hero Stats Strip -->
    <div class="flex lg:flex-col gap-6 lg:gap-5 shrink-0">
      <div class="glass-card rounded-2xl px-5 py-4 text-center min-w-[110px]">
        <p class="text-3xl font-bold text-white counter-animate" data-target="50000">50K+</p>
        <p class="text-xs text-blue-200 mt-0.5">Products</p>
      </div>
      <div class="glass-card rounded-2xl px-5 py-4 text-center min-w-[110px]">
        <p class="text-3xl font-bold text-white">5K+</p>
        <p class="text-xs text-blue-200 mt-0.5">Sellers</p>
      </div>
      <div class="glass-card rounded-2xl px-5 py-4 text-center min-w-[110px]">
        <p class="text-3xl font-bold text-white">1M+</p>
        <p class="text-xs text-blue-200 mt-0.5">Happy Buyers</p>
      </div>
    </div>
  </div>
</section>

<!-- FEATURE STRIP -->
<section class="bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
  <div class="max-w-screen-xl mx-auto px-4 py-5">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="flex items-center gap-3 py-2">
        <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-800 dark:text-white">AI Search</p>
          <p class="text-xs text-neutral-500">Voice & image powered</p>
        </div>
      </div>
      <div class="flex items-center gap-3 py-2">
        <div class="w-9 h-9 rounded-xl bg-teal-50 dark:bg-teal-900/30 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-teal-DEFAULT" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-800 dark:text-white">Secure Checkout</p>
          <p class="text-xs text-neutral-500">100% buyer protection</p>
        </div>
      </div>
      <div class="flex items-center gap-3 py-2">
        <div class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-amber-DEFAULT" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-800 dark:text-white">Easy Returns</p>
          <p class="text-xs text-neutral-500">Hassle-free refunds</p>
        </div>
      </div>
      <div class="flex items-center gap-3 py-2">
        <div class="w-9 h-9 rounded-xl bg-purple-50 dark:bg-purple-900/30 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-purple-DEFAULT" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-800 dark:text-white">Fast Delivery</p>
          <p class="text-xs text-neutral-500">Same-day in select cities</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORY GRID -->
<section class="max-w-screen-xl mx-auto px-4 py-12">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">Shop by Category</h2>
    <a href="/products" class="text-sm text-primary hover:underline font-medium">View All →</a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
    <%
    const categories = [
      { name: 'Electronics', icon: '💻', color: 'from-blue-500 to-blue-600', href: '/products?category=Electronics' },
      { name: 'Fashion',     icon: '👗', color: 'from-pink-500 to-rose-500',  href: '/products?category=Fashion' },
      { name: 'Home',        icon: '🏠', color: 'from-amber-500 to-orange-500', href: '/products?category=Home' },
      { name: 'Sports',      icon: '⚽', color: 'from-green-500 to-teal-500', href: '/products?category=Sports' },
      { name: 'Books',       icon: '📚', color: 'from-purple-500 to-indigo-500', href: '/products?category=Books' },
      { name: 'Beauty',      icon: '💄', color: 'from-fuchsia-500 to-pink-500', href: '/products?category=Beauty' },
    ];
    categories.forEach(cat => { %>
      <a href="<%= cat.href %>"
        class="group flex flex-col items-center gap-3 p-4 rounded-2xl bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 hover:border-transparent hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br <%= cat.color %> flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform duration-200">
          <%= cat.icon %>
        </div>
        <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-200 text-center"><%= cat.name %></span>
      </a>
    <% }); %>
  </div>
</section>

<!-- FEATURED PRODUCTS PLACEHOLDER -->
<section class="max-w-screen-xl mx-auto px-4 pb-12">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">Featured Products</h2>
    <a href="/products?featured=true" class="text-sm text-primary hover:underline font-medium">View All →</a>
  </div>
  <!-- Skeleton cards while loading -->
  <div id="featured-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
    <% for (let i = 0; i < 10; i++) { %>
      <div class="animate-pulse rounded-2xl bg-neutral-200 dark:bg-neutral-700 h-64"></div>
    <% } %>
  </div>
  <p class="text-center text-sm text-neutral-400 mt-4">Products loading from the database...</p>
</section>

<!-- SELL ON E-BAZAR CTA BANNER -->
<% if (typeof user === 'undefined' || !user || (user && user.role === 'customer')) { %>
<section class="max-w-screen-xl mx-auto px-4 pb-14">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-navy-DEFAULT to-blue-700 text-white px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="absolute right-0 top-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
    <div class="space-y-2 text-center md:text-left">
      <h2 class="text-2xl font-bold">Start Selling on E-Bazar Today</h2>
      <p class="text-blue-200 text-sm max-w-md">Reach millions of buyers, manage your inventory, and grow your business with powerful seller tools.</p>
    </div>
    <a href="/seller/register" id="cta-become-seller-btn"
      class="shrink-0 inline-flex items-center gap-2 bg-white text-navy-DEFAULT font-bold px-8 py-3.5 rounded-full hover:bg-blue-50 shadow-xl transition-all duration-200 hover:-translate-y-0.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Become a Seller
    </a>
  </div>
</section>
<% } %>
