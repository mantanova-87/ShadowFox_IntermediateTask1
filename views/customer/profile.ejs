<!-- ===== CUSTOMER PROFILE PAGE ===== -->
<% title = 'My Profile' %>
<% style = '<style>.glass-form { background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); }</style>' %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8">My Profile</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <!-- Profile Info Card -->
    <div class="md:col-span-1">
      <div class="glass-form rounded-3xl p-6 text-center shadow-lg">
        <div class="relative w-32 h-32 mx-auto mb-4 group">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" class="w-full h-full object-cover rounded-full ring-4 ring-primary/30" alt="Avatar">
          <% } else { %>
            <div class="w-full h-full rounded-full bg-gradient-to-br from-primary to-purple-600 flex items-center justify-center text-4xl font-bold text-white shadow-inner">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <!-- Hover overlay to change picture -->
          <label class="absolute inset-0 bg-black/50 text-white rounded-full flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-xs font-medium">Update</span>
            <input type="file" class="hidden" accept="image/*" id="avatar-upload">
          </label>
        </div>
        
        <h2 class="text-xl font-semibold"><%= user.name %></h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2"><%= user.email %></p>
        <% if (user.isVerified) { %>
          <span class="inline-flex items-center gap-1 text-xs font-medium bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-300 px-2.5 py-1 rounded-full">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Verified
          </span>
        <% } else { %>
          <span class="inline-flex items-center gap-1 text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 px-2.5 py-1 rounded-full cursor-pointer hover:underline" onclick="verifyEmail()">
            Unverified (Click to verify)
          </span>
        <% } %>
      </div>

      <!-- Account Actions -->
      <div class="mt-6 flex flex-col gap-3">
        <% if (user.role === 'customer') { %>
          <a href="/seller/register" class="w-full text-center bg-gradient-to-r from-purple-600 to-primary hover:from-purple-500 hover:to-blue-500 text-white font-medium py-3 rounded-xl shadow-lg transition-all active:scale-[0.98]">
            Become a Seller
          </a>
        <% } else if (user.role === 'seller') { %>
          <div class="glass-form p-4 rounded-xl text-sm">
            <p class="font-semibold mb-1">Seller Status</p>
            <p class="capitalize <%= user.sellerStatus === 'approved' ? 'text-teal-500' : 'text-amber-500' %>"><%= user.sellerStatus %></p>
          </div>
        <% } %>
        
        <button id="delete-account-btn" class="w-full text-center bg-transparent border border-rose-500 text-rose-500 hover:bg-rose-500 hover:text-white font-medium py-3 rounded-xl transition-all">
          Delete Account
        </button>
      </div>
    </div>
    
    <!-- Profile Details & Addresses -->
    <div class="md:col-span-2 space-y-8">
      
      <!-- Personal Information -->
      <section class="glass-form p-6 md:p-8 rounded-3xl shadow-sm">
        <h3 class="text-lg font-semibold mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Personal Information
        </h3>
        
        <form id="profile-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-1">Full Name</label>
              <input type="text" name="name" value="<%= user.name %>" required class="w-full bg-white dark:bg-black/20 border border-neutral-200 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Phone Number</label>
              <input type="tel" name="phone" value="<%= user.phone || '' %>" class="w-full bg-white dark:bg-black/20 border border-neutral-200 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
            </div>
          </div>
          <div class="flex justify-end pt-4">
            <button type="submit" class="bg-primary hover:bg-blue-600 text-white font-medium px-6 py-2.5 rounded-xl shadow-md transition-all active:scale-95">Save Changes</button>
          </div>
        </form>
      </section>
      
      <!-- Address Book -->
      <section class="glass-form p-6 md:p-8 rounded-3xl shadow-sm">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Address Book
          </h3>
          <button id="add-address-btn" class="text-sm font-medium text-primary hover:underline">
            + Add New
          </button>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% if (user.addresses && user.addresses.length > 0) { %>
            <% user.addresses.forEach((addr, index) => { %>
              <div class="border border-neutral-200 dark:border-neutral-700 rounded-2xl p-4 relative group hover:border-primary/50 transition-colors">
                <% if (addr.isDefault) { %>
                  <span class="absolute top-4 right-4 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Default</span>
                <% } %>
                <h4 class="font-semibold text-sm mb-1"><%= addr.label %></h4>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                  <%= addr.fullName %><br>
                  <%= addr.line1 %><% if (addr.line2) { %>, <%= addr.line2 %><% } %><br>
                  <%= addr.city %>, <%= addr.state %> <%= addr.postalCode %><br>
                  <%= addr.country %><br>
                  Tel: <%= addr.phone %>
                </p>
                <div class="mt-3 flex gap-3 text-sm opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="text-blue-500 hover:underline">Edit</button>
                  <button class="text-rose-500 hover:underline">Delete</button>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-span-2 text-center py-8 text-neutral-500 bg-neutral-100 dark:bg-neutral-800/50 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-700">
              No addresses saved yet.
            </div>
          <% } %>
        </div>
      </section>
      
    </div>
  </div>
</div>

<script>
  document.getElementById('delete-account-btn').addEventListener('click', async () => {
    if (!confirm('Are you sure you want to delete your account? This action cannot be undone.')) return;
    try {
      const res = await fetch('/api/v1/auth/account', { method: 'DELETE' });
      const data = await res.json();
      if (res.ok) {
        window.location.href = '/';
      } else {
        showToast(data.error || 'Failed to delete account', 'error');
      }
    } catch (err) {
      showToast('Network error', 'error');
    }
  });

  const verifyEmail = async () => {
    // In a real app, this would hit an endpoint to re-send the verification email
    showToast('Verification email sent to your inbox.', 'info');
  };
</script>
