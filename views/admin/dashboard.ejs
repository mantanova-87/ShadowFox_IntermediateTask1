<%- layout('layouts/layout') %>

<div class="min-h-screen bg-gray-950 text-white">

  <!-- Admin Sidebar + Content Layout -->
  <div class="flex">

    <!-- Sidebar -->
    <aside class="w-64 min-h-screen bg-gray-900 border-r border-white/5 flex flex-col pt-20 px-4 fixed top-0 left-0">
      <div class="mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-gray-500 px-2">Admin Panel</span>
      </div>
      <nav class="space-y-1 flex-1">
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-violet-600/20 text-violet-300 font-medium text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1z"/></svg>
          Dashboard
        </a>
        <a href="#users-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-white/5 hover:text-white text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Users
        </a>
        <a href="#products-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-white/5 hover:text-white text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Products
        </a>
        <a href="#tickets-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-white/5 hover:text-white text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
          Support Tickets
        </a>
        <a href="#coupons-section" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-white/5 hover:text-white text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          Coupons
        </a>
      </nav>
      <div class="pb-4 pt-4 border-t border-white/5">
        <form action="/api/v1/auth/logout" method="POST">
          <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-400 hover:text-red-300 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Sign Out
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 pt-20 p-8">

      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-white">Admin Dashboard</h1>
        <p class="text-gray-400 text-sm mt-1">Platform overview and management controls</p>
      </div>

      <!-- Stats Grid (populated via JS fetch) -->
      <div id="stats-grid" class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-10">
        <!-- Stats cards injected by admin.js -->
        <div class="col-span-full text-center py-10 text-gray-500">
          <div class="inline-block w-8 h-8 border-2 border-violet-500 border-t-transparent rounded-full animate-spin mb-3"></div>
          <p class="text-sm">Loading dashboard stats…</p>
        </div>
      </div>

      <!-- Pending Sellers Section -->
      <section id="users-section" class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-white">Pending Seller Applications</h2>
          <button onclick="loadPendingSellers()"
                  class="text-xs px-3 py-1.5 bg-violet-600/20 text-violet-300 rounded-lg hover:bg-violet-600/30 transition-colors">
            Refresh
          </button>
        </div>
        <div id="pending-sellers" class="bg-gray-900 rounded-xl border border-white/5 overflow-hidden">
          <div class="p-6 text-center text-gray-500 text-sm">Click refresh to load pending applications</div>
        </div>
      </section>

      <!-- Products Section -->
      <section id="products-section" class="mb-10">
        <h2 class="text-lg font-semibold text-white mb-4">Recent Products</h2>
        <div id="admin-products" class="bg-gray-900 rounded-xl border border-white/5 overflow-hidden">
          <div class="p-6 text-center text-gray-500 text-sm">Loading…</div>
        </div>
      </section>

      <!-- Support Tickets -->
      <section id="tickets-section" class="mb-10">
        <h2 class="text-lg font-semibold text-white mb-4">Open Support Tickets</h2>
        <div id="admin-tickets" class="bg-gray-900 rounded-xl border border-white/5 overflow-hidden">
          <div class="p-6 text-center text-gray-500 text-sm">Loading…</div>
        </div>
      </section>

      <!-- Coupons -->
      <section id="coupons-section" class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-white">Coupons</h2>
          <button onclick="document.getElementById('create-coupon-form').classList.toggle('hidden')"
                  class="text-xs px-3 py-1.5 bg-emerald-600/20 text-emerald-300 rounded-lg hover:bg-emerald-600/30 transition-colors">
            + New Coupon
          </button>
        </div>

        <!-- Create Coupon Form -->
        <form id="create-coupon-form" class="hidden bg-gray-900 rounded-xl border border-white/5 p-5 mb-4 grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-400 mb-1">Code</label>
            <input id="coupon-code" type="text" placeholder="SAVE20" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 text-sm border border-white/10 focus:border-violet-500 outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Type</label>
            <select id="coupon-type" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 text-sm border border-white/10 focus:border-violet-500 outline-none">
              <option value="percent">Percentage</option>
              <option value="flat">Flat Amount</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Value</label>
            <input id="coupon-value" type="number" placeholder="20" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 text-sm border border-white/10 focus:border-violet-500 outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Min Order (₹)</label>
            <input id="coupon-min" type="number" placeholder="500" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 text-sm border border-white/10 focus:border-violet-500 outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Expires At</label>
            <input id="coupon-expires" type="date" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 text-sm border border-white/10 focus:border-violet-500 outline-none">
          </div>
          <div class="flex items-end">
            <button type="button" onclick="createCoupon()"
                    class="w-full px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold rounded-lg transition-colors">
              Create Coupon
            </button>
          </div>
        </form>

        <div id="admin-coupons" class="bg-gray-900 rounded-xl border border-white/5 overflow-hidden">
          <div class="p-6 text-center text-gray-500 text-sm">Loading…</div>
        </div>
      </section>

    </main>
  </div><!-- end flex -->
</div>

<% /* Page-specific scripts injected via layout extractScripts */ %>
<script>
const ADMIN_BASE = window.location.pathname.replace(/\/$/, '');

async function loadDashboardStats() {
  try {
    const r = await fetch(`${ADMIN_BASE}/api/dashboard`);
    const { data } = await r.json();
    const labels = { totalUsers: 'Customers', totalSellers: 'Sellers', totalProducts: 'Products', totalOrders: 'Orders', pendingSellers: 'Pending Sellers', openTickets: 'Open Tickets' };
    const colors = { totalUsers: 'blue', totalSellers: 'emerald', totalProducts: 'violet', totalOrders: 'amber', pendingSellers: 'orange', openTickets: 'red' };
    document.getElementById('stats-grid').innerHTML = Object.entries(data).map(([k, v]) => `
      <div class="bg-gray-900 rounded-xl border border-white/5 p-4">
        <p class="text-xs text-gray-400 mb-1">${labels[k] || k}</p>
        <p class="text-2xl font-bold text-white">${v.toLocaleString()}</p>
      </div>`).join('');
  } catch(e) { console.error('Failed to load stats', e); }
}

async function loadPendingSellers() {
  const r = await fetch(`${ADMIN_BASE}/api/users?sellerStatus=pending`);
  const { data } = await r.json();
  const el = document.getElementById('pending-sellers');
  if (!data.length) { el.innerHTML = '<div class="p-6 text-center text-gray-500 text-sm">No pending applications</div>'; return; }
  el.innerHTML = `<table class="w-full text-sm"><thead><tr class="border-b border-white/5 text-left text-gray-400"><th class="px-4 py-3">Name</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Business</th><th class="px-4 py-3">Actions</th></tr></thead><tbody>${data.map(u => `
    <tr class="border-b border-white/5 hover:bg-white/2">
      <td class="px-4 py-3 text-white">${u.name}</td>
      <td class="px-4 py-3 text-gray-400">${u.email}</td>
      <td class="px-4 py-3 text-gray-400">${u.businessName || '—'}</td>
      <td class="px-4 py-3 flex gap-2">
        <button onclick="approveSeller('${u._id}','approve')" class="px-3 py-1 bg-emerald-600/20 text-emerald-300 rounded-lg text-xs hover:bg-emerald-600/30">Approve</button>
        <button onclick="approveSeller('${u._id}','reject')" class="px-3 py-1 bg-red-600/20 text-red-300 rounded-lg text-xs hover:bg-red-600/30">Reject</button>
      </td>
    </tr>`).join('')}</tbody></table>`;
}

async function approveSeller(userId, action) {
  await fetch(`${ADMIN_BASE}/api/users/${userId}/seller`, { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ action }) });
  loadPendingSellers();
}

async function createCoupon() {
  const body = {
    code: document.getElementById('coupon-code').value,
    type: document.getElementById('coupon-type').value,
    value: Number(document.getElementById('coupon-value').value),
    minOrder: Number(document.getElementById('coupon-min').value) || 0,
    expiresAt: document.getElementById('coupon-expires').value,
  };
  await fetch(`${ADMIN_BASE}/api/coupons`, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
  loadCoupons();
}

async function loadCoupons() {
  const r = await fetch(`${ADMIN_BASE}/api/coupons`);
  const { data } = await r.json();
  const el = document.getElementById('admin-coupons');
  if (!data.length) { el.innerHTML = '<div class="p-6 text-center text-gray-500 text-sm">No coupons yet</div>'; return; }
  el.innerHTML = `<table class="w-full text-sm"><thead><tr class="border-b border-white/5 text-left text-gray-400"><th class="px-4 py-3">Code</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Value</th><th class="px-4 py-3">Used</th><th class="px-4 py-3">Expires</th><th class="px-4 py-3"></th></tr></thead><tbody>${data.map(c=>`
    <tr class="border-b border-white/5"><td class="px-4 py-3 font-mono text-violet-300">${c.code}</td><td class="px-4 py-3 text-gray-400">${c.type}</td><td class="px-4 py-3 text-white">${c.type==='percent'?c.value+'%':'₹'+c.value}</td><td class="px-4 py-3 text-gray-400">${c.usageCount||0}</td><td class="px-4 py-3 text-gray-400">${c.expiresAt?new Date(c.expiresAt).toLocaleDateString():'Never'}</td><td class="px-4 py-3"><button onclick="deleteCoupon('${c._id}')" class="text-xs text-red-400 hover:text-red-300">Delete</button></td></tr>`).join('')}</tbody></table>`;
}

async function deleteCoupon(id) {
  if (!confirm('Delete this coupon?')) return;
  await fetch(`${ADMIN_BASE}/api/coupons/${id}`, { method: 'DELETE' });
  loadCoupons();
}

// Init
loadDashboardStats();
loadPendingSellers();
loadCoupons();
</script>
