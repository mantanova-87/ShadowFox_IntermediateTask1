<!-- ===== SELLER REGISTRATION PAGE ===== -->
<% title = 'Become a Seller' %>
<% style = '<style>.glass-card { background: rgba(255,255,255,0.05); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.1); }</style>' %>

<div class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 overflow-hidden bg-gradient-to-br from-neutral-50 to-blue-50 dark:from-neutral-900 dark:to-navy-900">
  
  <!-- Decorative blobs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-2xl w-full">
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Partner with E-Bazar</h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-300">Join thousands of sellers. Start growing your business today.</p>
    </div>

    <div class="glass-card shadow-2xl rounded-3xl p-8 sm:p-10">
      
      <% if (user && user.role === 'seller') { %>
        <!-- Already applied/approved state -->
        <div class="text-center py-8">
          <div class="w-16 h-16 mx-auto bg-teal-100 dark:bg-teal-900/40 text-teal-600 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h2 class="text-2xl font-bold mb-2">Application Received</h2>
          <p class="text-neutral-600 dark:text-neutral-300 mb-6">Your seller status is currently: <strong class="uppercase text-primary"><%= user.sellerStatus %></strong></p>
          <% if (user.sellerStatus === 'approved') { %>
            <a href="/seller/dashboard" class="bg-primary text-white px-6 py-2.5 rounded-xl font-medium hover:bg-blue-600 transition-colors">Go to Dashboard</a>
          <% } else { %>
            <p class="text-sm text-neutral-500">We will notify you via email once your application is reviewed.</p>
          <% } %>
        </div>
      <% } else { %>
        <!-- Application Form -->
        <form id="seller-register-form" class="space-y-6" action="/api/v1/user/become-seller" method="POST">
          
          <div class="space-y-4">
            <h3 class="text-lg font-semibold border-b border-neutral-200 dark:border-neutral-700 pb-2">Business Information</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-1">Business Name</label>
                <input type="text" name="businessName" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="Acme Corp">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Business Type</label>
                <select name="businessType" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
                  <option value="" disabled selected>Select Type</option>
                  <option value="Sole Proprietorship">Sole Proprietorship</option>
                  <option value="Partnership">Partnership</option>
                  <option value="Private Limited">Private Limited</option>
                  <option value="Public Limited">Public Limited</option>
                </select>
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium mb-1">Tax ID / GST Number</label>
                <input type="text" name="taxId" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="e.g. 22AAAAA0000A1Z5">
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <h3 class="text-lg font-semibold border-b border-neutral-200 dark:border-neutral-700 pb-2 mt-4">Bank Details</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium mb-1">Account Holder Name</label>
                <input type="text" name="bankDetails.accountHolder" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Account Number</label>
                <input type="text" name="bankDetails.accountNumber" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">IFSC / Swift Code</label>
                <input type="text" name="bankDetails.ifscCode" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium mb-1">Bank Name</label>
                <input type="text" name="bankDetails.bankName" required class="w-full bg-white dark:bg-black/20 border border-neutral-300 dark:border-white/10 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all">
              </div>
            </div>
          </div>

          <div class="pt-4">
            <button type="submit" class="w-full bg-gradient-to-r from-primary to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-bold text-lg py-4 rounded-xl shadow-lg shadow-blue-500/30 transition-all active:scale-[0.98]">
              Submit Application
            </button>
            <p class="text-xs text-center text-neutral-500 mt-4">By submitting, you agree to our Seller Terms and Conditions.</p>
          </div>
        </form>
      <% } %>

    </div>
  </div>
</div>

<script>
  const form = document.getElementById('seller-register-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      // NOTE: In a real implementation, we would send this to the backend endpoint
      // and the backend would set User.role='seller', User.sellerStatus='pending'.
      // For now, we simulate success and reload.
      setTimeout(() => {
        showToast('Application submitted successfully!', 'success');
        setTimeout(() => window.location.reload(), 1500);
      }, 1000);
    });
  }
</script>
